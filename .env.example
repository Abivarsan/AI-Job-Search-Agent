# ==============================================================================
# AI JOB SEARCH AGENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI EVALUATION (Google Gemini API)
# ------------------------------------------------------------------------------
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Minimum AI match score (0-100) required to trigger a notification
MIN_MATCH_SCORE=75

# ------------------------------------------------------------------------------
# 2. NOTIFICATION: WHATSAPP (Twilio API)
# ------------------------------------------------------------------------------
# Sign up at https://www.twilio.com/
# Find these credentials in your Twilio Console dashboard:
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# For testing with Twilio Sandbox for WhatsApp:
# From number is usually: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your personal WhatsApp number (must include country code, e.g. whatsapp:+1234567890)
# Remember to join the sandbox by sending "join <sandbox-code>" to the Twilio number first!
WHATSAPP_TO=whatsapp:+your_mobile_number_with_country_code

# ------------------------------------------------------------------------------
# 3. NOTIFICATION: TELEGRAM (Alternative / Zero-friction backup)
# ------------------------------------------------------------------------------
# Create a bot via @BotFather in Telegram and paste the token here:
TELEGRAM_BOT_TOKEN=
# Get your Chat ID by messaging @userinfobot or your bot in Telegram:
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 4. THIRD-PARTY JOB SEARCH API (Fallback for LinkedIn guest scraper)
# ------------------------------------------------------------------------------
# Optional: RapidAPI JSearch key (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
# Has a free monthly tier of 500 requests
RAPIDAPI_KEY=

# ------------------------------------------------------------------------------
# 5. SEARCH & SCHEDULING PREFERENCES
# ------------------------------------------------------------------------------
# Target search keywords (comma-separated)
SEARCH_KEYWORDS=Associate Software Engineer, Software Engineer, Junior Software Engineer, .NET Developer, Java Developer

# Target locations (comma-separated: Sri Lanka for on-site/hybrid/remote, Remote for global)
SEARCH_LOCATIONS=Sri Lanka, Remote

# Run frequency in minutes when operating in background daemon mode (default: 180 = every 3 hours)
POLL_INTERVAL_MINUTES=180

# SQLite database file path
DATABASE_URL=sqlite:///jobs_database.db
